pipeline {
    agent any
    tools {
        terraform 'Terraform'
    }

    environment {
        AWS_DEFAULT_REGION = 'eu-north-1'
    }

    parameters {
        string(
            name: 'RUN_STAGE',
            defaultValue: 'None',
            description: 'Enter the stage to run (e.g., apply or destroy)'
        )
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/NaveenNave-hub/Terraform-ec2instance.git'
            }
        }

        stage('Terraform Init') {
            when { expression { params.RUN_STAGE == 'apply' || params.RUN_STAGE == 'destroy' } }
            steps {
                withAWS(credentials: 'aws-credentials', region: 'eu-north-1') {
                    bat 'terraform init'
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.RUN_STAGE == 'apply' } }
            steps {
                withAWS(credentials: 'aws-credentials', region: 'eu-north-1') {
                    bat 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.RUN_STAGE == 'apply' } }
            steps {
                withAWS(credentials: 'aws-credentials', region: 'eu-north-1') {
                    bat 'terraform apply -auto-approve tfplan'
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.RUN_STAGE == 'destroy' } }
            steps {
                withAWS(credentials: 'aws-credentials', region: 'eu-north-1') {
                    bat 'terraform destroy -auto-approve'
                }
            }
        }
    }
}
